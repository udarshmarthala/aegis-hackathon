# =============================================================================
# Aegis console - frontend environment contract
# =============================================================================
# Copy to .env.local for local development, or paste these into your hosting
# provider's environment settings.
#
# IMPORTANT: every NEXT_PUBLIC_* value is inlined into the JavaScript bundle at
# BUILD time, not read at runtime. Changing one in a hosting dashboard does
# nothing until you redeploy. They are also public by definition - they
# identify the project, they do not authorise anything.
# =============================================================================

# ---- API ---------------------------------------------------------------------
# Origin of the Aegis API, as the browser reaches it.
# Must be https:// when the console itself is served over https, or the browser
# blocks the request as mixed content. Leave as localhost only for local dev.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional. A private address for the API used only by server-side rendering
# (compose, ECS). Unset on a hosting platform with no private network - the
# console then falls back to NEXT_PUBLIC_API_BASE_URL.
# AEGIS_API_INTERNAL_URL=http://api:8000

# ---- deployment identity -----------------------------------------------------
# local | staging | production
# Only the exact value `local` enables the development sign-in bypass. Anything
# else - including leaving this unset - withholds it. Never set this to `local`
# on a deployment reachable from the internet.
NEXT_PUBLIC_AEGIS_ENV=local

# ---- Firebase web auth -------------------------------------------------------
# All three of API_KEY, AUTH_DOMAIN and PROJECT_ID are required together; with
# any of them missing the console offers no Firebase sign-in and says so,
# rather than rendering buttons that cannot work.
# Remember to add your deployed domain to Firebase Console ->
# Authentication -> Settings -> Authorized domains, or the sign-in popup fails
# with auth/unauthorized-domain.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Optional.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- build mode --------------------------------------------------------------
# Set to 1 only for the container image build, which ships Next.js standalone
# output. Managed hosting builds its own serverless output and ignores it.
# BUILD_STANDALONE=1
