crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
tfplan
*.tfplan

# ---- cloud credentials ----
.aws/
*.csv
!eval/**/*.csv
.vercel/

