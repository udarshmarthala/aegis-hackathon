# ---- local runtime state ----
logs/
*.log
tmp/
.DS_Store
Thumbs.db
eval/reports/*.json
!eval/reports/.gitkeep
# Root-only: a bare `data/` also matched infra/terraform/modules/data/, which
# silently excluded a whole Terraform module from the repository.
/data/

