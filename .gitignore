# ---- secrets: never commit ----
.env
.env.*
!.env.example
secrets.md
*.pem
*.key
.secrets/
secrets/
**/firebase-service-account.json
**/serviceAccount*.json
*credentials*.json
aegis_accessKeys.csv
llm-api-keys.txt
firebase-details.txt

# ---- python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
coverage.xml
dist/
build/

# ---- node / next ----
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
.eslintcache
next-env.d.ts

# ---- graphify knowledge graph (regenerable, large) ----
graphify-out/
