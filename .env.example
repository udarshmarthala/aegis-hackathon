# =============================================================================
# Aegis 2.0 — environment contract
# Copy to .env and fill. NEVER commit .env.
# Every variable consumed by the platform is declared here; backend/src/aegis/
# core/config.py validates this file at boot and fails closed on bad values.
# =============================================================================

# ---- deployment identity -----------------------------------------------------
AEGIS_ENV=local                      # local | staging | production
AEGIS_ENVIRONMENT_NAME=local-docker  # human label shown in UI environment picker
AEGIS_VERSION=2.0.0
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                      # json | console

# ---- API ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
# Comma-separated exact origins. No wildcards in staging/production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Shared secret for machine-to-machine alert ingestion (Alertmanager -> Aegis).
# Generate: openssl rand -hex 32
ALERT_INGEST_TOKEN=change-me-ingest-token
# Signing key for internal short-lived service tokens. openssl rand -hex 32
INTERNAL_SIGNING_KEY=change-me-internal-signing-key

# ---- PostgreSQL (system of record) -------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=16
POSTGRES_STATEMENT_TIMEOUT_MS=15000
# Host port for the dev container. Not 5432 (a natively installed PostgreSQL
# usually owns it and shadows Docker's proxy) and not 55432 (the obvious
# second choice, seen in use by an unrelated project). Containers talk to
# each other on 5432 regardless; this only moves the host mapping.
POSTGRES_PUBLISH_PORT=55433

# ---- Redis (cache / coordination, never authoritative) -----------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- Neo4j (operational knowledge graph) -------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j
NEO4J_DATABASE=neo4j

# ---- Telemetry / evidence sources --------------------------------------------
PROMETHEUS_URL=http://prometheus:9090
TEMPO_URL=http://tempo:3200
LOKI_URL=http://loki:3100
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=aegis-api
OTEL_TRACES_ENABLED=true

# ---- LLM provider: Google AI Studio ------------------------------------------
# One vendor, up to four keys. Redundancy is per key, not per vendor: Gemini
# quotas are enforced per key and per day, so the thing that gets exhausted is
# the key. Keys are tried in this order; an exhausted one is parked and the next
# is used (backend/src/aegis/core/keyring.py).
GOOGLE_API_KEY=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GOOGLE_API_KEY_4=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Native Gemini ids only. A "vendor/model" prefix is stripped before the call,
# because the native endpoint answers one with a 404 - which during failover is
# indistinguishable from an outage.
LLM_MODEL_FAST=gemini-3.6-flash
LLM_MODEL_REASONING=gemini-3.6-flash
LLM_MODEL_CODE=gemini-3.6-flash

# gemini-embedding-001 returns 3072 dimensions unless asked otherwise; the
# corpus columns are vector(1536) and migrations are forward-only, so the width
# is requested explicitly on every call.
LLM_EMBEDDING_MODEL=gemini-embedding-001
LLM_EMBEDDING_DIM=1536

LLM_MAX_OUTPUT_TOKENS=8192
LLM_REQUEST_TIMEOUT_S=90
LLM_MAX_RETRIES=2

# ---- LangSmith (AI observability + evaluation) -------------------------------
# LangSmith failure must NEVER halt an incident workflow (ESD §34).
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aegis-2.0
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- Firebase auth (frontend identity + backend token verification) ----------
# Web config values are public by design (they identify, they do not authorize).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Backend verifies Firebase ID tokens with the Admin SDK service account.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json
# When true the API accepts a dev bearer token instead of Firebase. local only.
AUTH_DEV_MODE=false
AUTH_DEV_BYPASS_TOKEN=

# ---- Frontend ----------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_AEGIS_ENV=local

# ---- GitHub (change intelligence + code retrieval) ---------------------------
GITHUB_TOKEN=
GITHUB_DEFAULT_OWNER=
GITHUB_API_URL=https://api.github.com

# ---- Slack (notification only; never a source of authority) -----------------
# A bot token can post and later edit a message; a webhook can only post.
# Leave both empty and Slack reports itself unconfigured rather than failing.
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=
SLACK_DEFAULT_CHANNEL=

# ---- Agent budgets (hard caps; agents may never raise their own) -------------
AGENT_MAX_WALL_SECONDS=600
AGENT_MAX_LLM_CALLS=40
AGENT_MAX_TOOL_CALLS=80
AGENT_MAX_TOKENS=400000
AGENT_MAX_PARALLEL_INVESTIGATORS=4
AGENT_HYPOTHESIS_LOOP_LIMIT=4

# ---- Autonomy / safety (fail closed) -----------------------------------------
# Master switch. When false, NO autonomous write action executes, ever.
AUTONOMY_ENABLED=false
# guarded = tier-1 allowlist only. off = observe only. See aegis/policy.
AUTONOMY_MODE=guarded                # off | guarded | standard
AUTONOMY_ALLOWED_TIERS=1
AUTONOMY_MAX_ACTIONS_PER_HOUR=10
APPROVAL_TTL_SECONDS=900
RESOURCE_LEASE_TTL_SECONDS=300

# ---- Debug sandbox -----------------------------------------------------------
SANDBOX_ENABLED=true
SANDBOX_IMAGE=aegis/sandbox-python:2.0
SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_WALL_CLOCK_LIMIT_S=300
SANDBOX_NETWORK=none
SANDBOX_DOCKER_HOST=unix:///var/run/docker.sock

# ---- Reference workload (the system Aegis observes) --------------------------
WORKLOAD_ADAPTER=compose             # compose | kubernetes | ecs
WORKLOAD_NAMESPACE=aegis-workload
KUBE_CONTEXT=kind-aegis
AWS_REGION=us-east-1
ECS_CLUSTER=
